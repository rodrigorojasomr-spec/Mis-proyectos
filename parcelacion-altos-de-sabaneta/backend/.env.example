# Cadena de conexión a Postgres/Supabase
URL_BASE_DATOS=postgresql://usuario:clave@db.tuproyecto.supabase.co:5432/postgres

# Clave secreta para firmar los tokens JWT (generar una aleatoria y larga en producción)
CLAVE_SECRETA_JWT=cambia-esta-clave-por-una-aleatoria-y-larga

ALGORITMO_JWT=HS256
MINUTOS_EXPIRACION_TOKEN=480

# Orígenes permitidos para CORS, separados por coma si son varios (formato JSON en pydantic-settings)
ORIGENES_PERMITIDOS=["http://localhost:3000"]
